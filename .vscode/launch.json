{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "omni_bridge",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "omni_bridge (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "omni_bridge (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Python: flutter_server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/flutter_server.py",
            "cwd": "${workspaceFolder}/server",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "OMNI_BRIDGE_DEBUG": "true",
                "PYTHONPATH": "${workspaceFolder}/server"
            }
        }
    ]
}
