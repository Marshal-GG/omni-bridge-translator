rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Feedback attachments — owner read/write only, max 10 MB per file.
    match /feedback_attachments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
                            request.auth.uid == userId &&
                            request.resource.size < 10 * 1024 * 1024;
    }

    // System / marketing assets — public read only.
    match /assets/{allPaths=**} {
      allow read: if true;
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
